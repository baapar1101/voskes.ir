---
import Base from '../../layouts/Base.astro';
import bodyHtml from './_contact.content.html?raw';
import headerHtml from './_contact.header.html?raw';
import cookieBannerHtml from './_contact.cookie.html?raw';
import footerHtml from './_contact.footer.html?raw';

---

<Base
	title="با Voskes در تماس باشید"
	description="You can get in contact with us through our contactform."
	canonical="https://voskes.nl/en/contact"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="Get in Contact with Voskes"
	ogDescription="You can get in contact with us through our contactform. "
	bodyClass="Page"
	
	
>
	<Fragment set:html={bodyHtml} />
</Base>
