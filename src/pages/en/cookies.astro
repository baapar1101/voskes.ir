---
import Base from '../../layouts/Base.astro';
import bodyHtml from './_cookies.content.html?raw';
import headerHtml from './_cookies.header.html?raw';
import cookieBannerHtml from './_cookies.cookie.html?raw';
import footerHtml from './_cookies.footer.html?raw';

---

<Base
	title="کوکی‌های Voskes"
	description="The information that the cookies provide can help us to analyse our visitors profile and gives us the opportunity to offer you a better user experience."
	canonical="https://voskes.nl/en/cookies"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="Cookes of Voskes"
	ogDescription="The information that the cookies provide can help us to analyse our visitors profile and gives us the opportunity to offer you a better user experience."
	bodyClass="Page"
	
	
>
	<Fragment set:html={bodyHtml} />
</Base>
