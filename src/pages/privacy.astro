---
import Base from '../layouts/Base.astro';
import bodyHtml from './_privacy.content.html?raw';
import headerHtml from './_privacy.header.html?raw';
import cookieBannerHtml from './_privacy.cookie.html?raw';
import footerHtml from './_privacy.footer.html?raw';

import rootVars from './_privacy.root-vars.css?raw';
import cookieboxCss from './_privacy.cookiebox.css?raw';
import utilityColors from './_privacy.utility-colors.css?raw';
---

<Base
	title="بیانیه حریم خصوصی Voskes"
	description="Holland Diervoeders B.V. حفاظت از داده‌های شخصی را ضروری می‌داند و داده‌های شما را با نهایت دقت پردازش می‌کند."
	canonical="https://voskes.ir/privacy"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="بیانیه حریم خصوصی Voskes"
	ogDescription="Holland Diervoeders B.V. حفاظت از داده‌های شخصی را ضروری می‌داند و داده‌های شما را با نهایت دقت پردازش می‌کند."
	bodyClass="Page"
	
	
	rootVars={rootVars}
	cookieboxCss={cookieboxCss}
	utilityColors={utilityColors}
>
	<Fragment set:html={bodyHtml} />
</Base>
