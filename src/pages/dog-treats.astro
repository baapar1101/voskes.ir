---
import Base from '../layouts/Base.astro';
import bodyHtml from './_dog-treats.content.html?raw';
import headerHtml from './_dog-treats.header.html?raw';
import cookieBannerHtml from './_dog-treats.cookie.html?raw';
import footerHtml from './_dog-treats.footer.html?raw';

import rootVars from './_dog-treats.root-vars.css?raw';
import cookieboxCss from './_dog-treats.cookiebox.css?raw';
import utilityColors from './_dog-treats.utility-colors.css?raw';
---

<Base
	title="تشویقی‌ها و خوراکی‌های فراوان برای غافلگیر کردن سگ شما با Voskes!"
	description="می‌خواهید دوست چهارپایتان را با خوراکی خوشمزه نوازش کنید؟ در Voskes تنوع گسترده‌ای از تشویقی سگ داریم!"
	canonical="https://voskes.nl/dog-treats"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="تشویقی‌ها و خوراکی‌های فراوان برای غافلگیر کردن سگ شما با Voskes!"
	ogDescription="می‌خواهید دوست چهارپایتان را با خوراکی خوشمزه نوازش کنید؟ در Voskes تنوع گسترده‌ای از تشویقی سگ داریم!"
	bodyClass="Page"
	
	
	rootVars={rootVars}
	cookieboxCss={cookieboxCss}
	utilityColors={utilityColors}
>
	<Fragment set:html={bodyHtml} />
</Base>
