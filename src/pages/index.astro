---
import Base from '../layouts/Base.astro';
import bodyHtml from './_index.content.html?raw';
import headerHtml from './_index.header.html?raw';
import cookieBannerHtml from './_index.cookie.html?raw';
import footerHtml from './_index.footer.html?raw';

import rootVars from './_index.root-vars.css?raw';
import cookieboxCss from './_index.cookiebox.css?raw';
import utilityColors from './_index.utility-colors.css?raw';
---

<Base
	title="Voskes — طعم شادی برای گربه‌ها و سگ‌ها"
	description="دوست پشمالوی شما از غذای خوب لذت می‌برد، اما گربه‌ها گاهی سخت‌پسندند. برای همین با Voskes منویی سالم و خوش‌طعم ارائه می‌کنیم."
	canonical="https://voskes.ir/en"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="Voskes — طعم شادی برای گربه‌ها و سگ‌ها"
	ogDescription="دوست پشمالوی شما از غذای خوب لذت می‌برد، اما گربه‌ها گاهی سخت‌پسندند. برای همین با Voskes منویی سالم و خوش‌طعم ارائه می‌کنیم."
	bodyClass="Dashboard"
	
	
	rootVars={rootVars}
	cookieboxCss={cookieboxCss}
	utilityColors={utilityColors}
>
	<Fragment set:html={bodyHtml} />
</Base>
