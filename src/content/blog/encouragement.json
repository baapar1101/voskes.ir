	"bodyHtml": "<div class=\"d--flex\" style=\"flex-wrap: wrap;\">\n                    \n\n                                        \n                            <div id=\"id-34-84\" class=\"section section__textblock section--none section--padding bg-c--soft-conversion txt-c--nero title-c--nero link-c--nero\">\n      <div class=\"san-container\">\n                    <div class=\"san-col\">\n        <div class=\"j-content txt--left pb--0 desktop-xl-pb--60\" data-type=\"container\">\n      <div class=\"j-content\" data-type=\"text\">\n          <h1>DRIED DOG SNACKS THAT WILL GIVE YOUR FOUR-LEGGED FRIEND HOURS OF CHEWING PLEASURE!</h1>\n\n                </div>\n    </div>\n                </div>\n\n          </div>\n</div>\n            \n            \n            \n            \n            \n            \n            \n            \n                    \n\n                                        \n            \n            \n            \n            \n            \n            \n                                <div class=\"section section--none section--padding bg-c--white txt-c--nero heading-c--nero link-c--nero\">\n    <div class=\"san-container\" style=\"justify-content: center;\"><div class=\"san-col\" data-span=\"12 tablet-lg-6 desktop-3\">  <div class=\"j-card bg-c--transparent txt-c--nero\" data-type=\"container\" data-lazyload=\"true\" data-background-image=\"/uploads/bg_image/bg_image-kauwsticks11-background_image-48-65.webp\" style=\"background-size: contain;\">\n    <div class=\"j-card\" data-type=\"head\" data-no-border=\"\" data-no-padding=\"\">\n\n                  <div class=\"ar ar--square\">\n            <div class=\"ar__content\">\n\n                \n            </div>\n          </div>\n        \n    </div>\n\n        <div class=\"j-card\" data-type=\"body\">\n            <div class=\"j-card txt--center\" data-type=\"title\">Chew sticks</div>\n            <div class=\"j-card\" data-type=\"content\"></div>\n    </div>\n    \n        </div>\n    </