---
import Base from '../../layouts/Base.astro';
import bodyHtml from './_our-story.content.html?raw';
import headerHtml from './_our-story.header.html?raw';
import cookieBannerHtml from './_our-story.cookie.html?raw';
import footerHtml from './_our-story.footer.html?raw';

---

<Base
	title="Voskes، از سال ۱۹۸۱ — داستان ما"
	description="Voskes has been known since 1981 for its many types of healthy snacks. For more than 40 years, dogs and cats have loved the delicious and honest taste of our treats."
	canonical="https://voskes.nl/en/our-story"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="Voskes, since 1981- our story"
	ogDescription="Voskes has been known since 1981 for its many types of healthy snacks. For more than 40 years, dogs and cats have loved the delicious and honest taste of our treats."
	bodyClass="Page"
	
	
>
	<Fragment set:html={bodyHtml} />
</Base>
