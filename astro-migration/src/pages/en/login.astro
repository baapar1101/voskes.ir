---
import Base from '../../layouts/Base.astro';
import bodyHtml from './_login.content.html?raw';
import headerHtml from './_login.header.html?raw';
import cookieBannerHtml from './_login.cookie.html?raw';
import footerHtml from './_login.footer.html?raw';

---

<Base
	title="ورود به بخش رسانه و مطبوعات Voskes"
	description="On our press kit page you can download Voskes materials for dogs and cats. These materials can be freely used for publications about Voskes."
	canonical="https://voskes.nl/en/login"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="Login for the press kit of Voskes"
	ogDescription="On our press kit page you can download Voskes materials for dogs and cats. These materials can be freely used for publications about Voskes."
	bodyClass="Login"
	
	
>
	<Fragment set:html={bodyHtml} />
</Base>
