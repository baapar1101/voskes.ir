import headerHtml from './_jelly-cups.header.html?raw';
import cookieBannerHtml from './_jelly-cups.cookie.html?raw';
import footerHtml from './_jelly-cups.footer.html?raw';

---

<Base
	title="Jelly Cups full of flavour for your cat with Voskes"
	description="With these cups filled with jelly and fine pieces of fish or meat, you will be able to tempt even the pickiest cat. They are irresistibly delicious!"
	canonical="https://voskes.nl/en/cat-treats/jelly-cups"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="Jelly Cups full of flavour for your cat with Voskes"
	ogDescription="With these cups filled with jelly and fine pieces of fish or meat, you will be able to tempt even the pickiest cat. They are irresistibly delicious!"
	bodyClass="Page"
	
	
>
	<Fragment set:html={bodyHtml} />
</Base>
