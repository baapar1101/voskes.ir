---
import Base from '../../../layouts/Base.astro';
import bodyHtml from './_creams.content.html?raw';
import headerHtml from './_creams.header.html?raw';
import cookieBannerHtml from './_creams.cookie.html?raw';
import footerHtml from './_creams.footer.html?raw';

---

<Base
	title="Creamy cat treat for extra taste experience with Voskes"
	description="These soft creams are a tasty and healthy treat for your furry housemate. Low in calories and flavourful, the Creams are responsible snacks that you can also put over kibble as a topping if your cat is a picky eater."
	canonical="https://voskes.nl/en/cat-treats/creams"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="Creamy cat treat for extra taste experience with Voskes"
	ogDescription="These soft creams are a tasty and healthy treat for your furry housemate. Low in calories and flavourful, the Creams are responsible snacks that you can also put over kibble as a topping if your cat is a picky eater."
	bodyClass="Page"
	
	
>
	<Fragment set:html={bodyHtml} />
</Base>
