---
import Base from '../layouts/Base.astro';
import bodyHtml from './_index.content.html?raw';
import headerHtml from './_index.header.html?raw';
import cookieBannerHtml from './_index.cookie.html?raw';
import footerHtml from './_index.footer.html?raw';
import extraBodyHtml from './_index.extra.html?raw';
---

<Base
	title="تشویقی خوشمزه سگ و گربه و غذای گربه از Voskes"
	description="Keuze uit meer dat 200 verschillende producten! We werken met natuurlijke ingrediënten voor de allerbeste kwaliteit voor jouw hond of kat."
	canonical="https://voskes.nl/nl"
	headerHtml={headerHtml}
	cookieBannerHtml={cookieBannerHtml}
	footerHtml={footerHtml}
	ogTitle="Heerlijke hondensnacks en kattensnacks en kattenvoeding van Voskes"
	ogDescription="Keuze uit meer dat 200 verschillende producten! We werken met natuurlijke ingrediënten voor de allerbeste kwaliteit voor jouw hond of kat. "
	bodyClass="Dashboard"
	
	extraBodyHtml={extraBodyHtml}
>
	<Fragment set:html={bodyHtml} />
</Base>
